{
  "name": "streamflow-position-transfer",
  "private": true,
  "version": "0.1.0",
  "description": "Unofficial local-first tool for safely transferring eligible Streamflow positions on Solana.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twentyOne2x/streamflow-position-transfer.git"
  },
  "bugs": {
    "url": "https://github.com/twentyOne2x/streamflow-position-transfer/issues"
  },
  "homepage": "https://github.com/twentyOne2x/streamflow-position-transfer#readme",
  "keywords": [
    "solana",
    "streamflow",
    "token-vesting",
    "vesting",
    "wallet-adapter"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4178 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4179 --strictPort",
    "audit:production": "node scripts/audit-allowlist.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "node --test scripts/audit-allowlist.node-test.mjs && vitest run",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@solana/spl-token": "0.4.9",
    "@solana/wallet-adapter-react": "0.15.39",
    "@solana/wallet-adapter-react-ui": "0.9.39",
    "@solana/web3.js": "1.98.4",
    "@streamflow/stream": "13.3.1",
    "bs58": "6.0.0",
    "buffer": "6.0.3",
    "lucide-react": "0.468.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vite-plugin-node-polyfills": "0.23.0",
    "vitest": "5.0.5"
  }
}
